+/* Lets a USB-connected iPhone or iPad screen appear as a muxed capture device, the way QuickTime
+ * Player does. The setting is per process, so it has to be made here, before devices are listed. */
+static void enable_screen_capture_devices(void)
+{
+    static int done = 0;
+    CMIOObjectPropertyAddress prop = {
+        kCMIOHardwarePropertyAllowScreenCaptureDevices,
+        kCMIOObjectPropertyScopeGlobal,
+        kCMIOObjectPropertyElementMain
+    };
+    UInt32 allow = 1;
+    if (done)
+        return;
+    done = 1;
+    if (CMIOObjectSetPropertyData(kCMIOObjectSystemObject, &prop, 0, NULL, sizeof(allow), &allow) == kCMIOHardwareNoError)
+        /* Connected devices are published asynchronously once allowed. */
+        [NSThread sleepForTimeInterval:1.0];
+}
