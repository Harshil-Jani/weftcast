{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recorder",
  "version": "0.1.0",
  "identifier": "dev.recorder.app",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Recorder",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      },
      {
        "label": "hud",
        "title": "Recorder controls",
        "url": "index.html#/hud",
        "width": 440,
        "height": 60,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "bubble",
        "title": "Recorder camera",
        "url": "index.html#/bubble",
        "width": 220,
        "height": 220,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/cloudflared",
      "binaries/yt-dlp",
      "binaries/scrcpy",
      "binaries/cli"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "binaries/scrcpy-server": "scrcpy-server"
    },
    "macOS": {
      "minimumSystemVersion": "12.3",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  }
}
